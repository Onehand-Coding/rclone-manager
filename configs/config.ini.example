; -----------------------------------------------------------------------------
; Rclone Scripts Manager - Example Configuration
;
; To use, copy this file to 'config.ini' and fill in your details.
; -----------------------------------------------------------------------------

[DEFAULT]
; --- General Settings ---
LOG_LEVEL = INFO
LOG_FILE = logs/rclone_scripts.log
DEFAULT_PORT = 8080

; --- Credentials for rclone serve ---
; Replace with the username and password you want to use for FTP/WebDAV/HTTP access.
USERNAME = your_username
PASSWORD = your_secret_password

; --- Hidden Files ---
; Set to true to include hidden files and directories (files/folders starting with .)
; Hidden files are excluded by default via automatic --exclude ".*" and --exclude ".*/" flags
INCLUDE_HIDDEN = false

; --- Fuzzy Search ---
; Set to true to use fzf for interactive selection (requires fzf installed)
; Set to false to use the legacy numbered-list interface
USE_FZF = true

; -----------------------------------------------------------------------------
; rclone Flags
;
; Add custom flags for different rclone remote types.
; The script will automatically apply these flags when using 'serve-remote'.
; Use a new line for each flag.
; -----------------------------------------------------------------------------

[rclone_flags]
mega =
    --vfs-cache-mode=full
    --vfs-cache-max-size=1G
    --vfs-cache-max-age=24h
drive =
    --vfs-cache-mode=full
    --vfs-cache-max-size=2G
google photos =
    --gphotos-read-size
    --vfs-cache-mode=full
    --vfs-cache-max-size=10G
    --vfs-cache-max-age=24h

; -----------------------------------------------------------------------------
; Exclude/Include Filters
;
; Global patterns applied to upload, download, sync, and ls operations.
; Uses rclone's filter syntax: https://rclone.org/filter/
; Use a new line for each pattern.
; -----------------------------------------------------------------------------

[filters]
exclude =
    node_modules/
    __pycache__/
    *.pyc
    *.tmp
    *.swp
